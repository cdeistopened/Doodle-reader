# AssemblyAI API Key for podcast transcription
VITE_ASSEMBLYAI_API_KEY=YOUR_ASSEMBLYAI_API_KEY

# Google Gemini API Key for AI summaries
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Clerk Authentication
# Get your publishable key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY

# PageSnap URL (optional)
# Defaults to https://pagesnap.railway.app if not set
# For local development, it will use http://localhost:5001
VITE_PAGESNAP_URL=

# Stripe Configuration (required for billing)
# Get these from https://dashboard.stripe.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PRICE_PRO_MONTHLY=price_...
VITE_STRIPE_PRICE_PRO_YEARLY=price_...
