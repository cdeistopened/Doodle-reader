# =============================================================================
# DOODLE READER - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Required variables are marked with [REQUIRED]
# =============================================================================

# =============================================================================
# AUTHENTICATION [REQUIRED]
# =============================================================================
# Clerk provides user authentication
# Get your publishable key from: https://dashboard.clerk.com
# 1. Create a Clerk application
# 2. Go to API Keys section
# 3. Copy the Publishable Key (starts with pk_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY

# =============================================================================
# AI & PROCESSING [REQUIRED for most features]
# =============================================================================
# Google Gemini API Key - Powers AI summaries and OCR
# Get from: https://ai.google.dev/
# 1. Go to Google AI Studio
# 2. Click "Get API Key"
# 3. Create a new key or use existing
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# AssemblyAI API Key - Powers podcast transcription
# Get from: https://www.assemblyai.com/
# 1. Create an account
# 2. Go to Dashboard > API Keys
# 3. Copy your API key
VITE_ASSEMBLYAI_API_KEY=YOUR_ASSEMBLYAI_API_KEY

# =============================================================================
# EXTERNAL SERVICES [OPTIONAL]
# =============================================================================
# PageSnap Scanner Service URL
# The PDF/book scanning service endpoint
# Defaults to https://pagesnap.railway.app if not set
# For local development: http://localhost:5001
VITE_PAGESNAP_URL=

# =============================================================================
# BILLING & STRIPE [OPTIONAL - required for paid features]
# =============================================================================
# Stripe handles payments and subscriptions
# Get from: https://dashboard.stripe.com
#
# 1. Create Stripe account and get API keys
# 2. Create Products & Prices in Stripe dashboard
# 3. Copy the price IDs (start with price_)
#
# Publishable key (safe for frontend, starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs from your Stripe dashboard
# Products > [Your Product] > Pricing > Copy price ID
VITE_STRIPE_PRICE_PRO_MONTHLY=price_...
VITE_STRIPE_PRICE_PRO_YEARLY=price_...

# =============================================================================
# SERVER-SIDE VARIABLES (set in Convex dashboard, not here)
# =============================================================================
# These are set in Convex Environment Variables, not in .env.local:
#
# STRIPE_SECRET_KEY - Your Stripe secret key (starts with sk_)
# STRIPE_WEBHOOK_SECRET - Webhook signing secret (starts with whsec_)
# CLERK_SECRET_KEY - Clerk backend secret key
# RESEND_API_KEY - Resend API key for digest email delivery
# RESEND_FROM_EMAIL - Sender identity, e.g. "DoodleDog <onboarding@resend.dev>"
# DOODLEDOG_APP_URL - Public app URL used for reader links in emails (e.g. https://doodlereader.com)
# DIGEST_MAX_ITEMS_DEFAULT - Optional max items per digest when stream filter is unset (default: 12)
# DIGEST_MAX_ITEMS_PER_SOURCE - Optional per-source cap to prevent feed dominance (default: 2)
#
# Set at: https://dashboard.convex.dev > Settings > Environment Variables
# =============================================================================
